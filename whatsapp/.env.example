# ============================================================================
# Kanda WhatsApp Service (Baileys) — Environment variables
# ============================================================================

# --- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Baileys / Session ------------------------------------------------------
# Persistable directory for the Baileys auth state (creds, sessions, keys).
# In production this MUST point to the Railway Volume mount path, e.g.:
#   BAILEYS_AUTH_DIR=/app/whatsapp/auth_info_baileys
# Local fallback (when unset): <service cwd>/auth_info_baileys
BAILEYS_AUTH_DIR=

# --- Backend communication ---------------------------------------------------
# Base URL of the NestJS backend (internal). It receives forwarded messages at
#   POST ${BACKEND_URL}/api/whatsapp/message
# using the header: X-Internal-Key: ${BACKEND_API_TOKEN}
BACKEND_URL=http://localhost:3001
BACKEND_API_TOKEN=change-me

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info