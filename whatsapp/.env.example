# Server
PORT=3000
HOST=0.0.0.0

# OpenWA / whatsapp-web.js
SESSION_DIR=./session
QR_CODE_OUTPUT=terminal
WA_WEB_VERSION=2

# Backend communication (for future phases)
BACKEND_URL=http://localhost:3001
BACKEND_AUTH_TOKEN=change-me

# Logging
LOG_LEVEL=info

# Reconnection
WA_RECONNECT_INTERVAL=30
# Timeout for sending messages (not used in WA-02)
WA_SEND_TIMEOUT=15000