# ==========================================
# LOCAL DEVELOPMENT .env FILE
# Copy from .env.example and edit as needed
# ==========================================

# NODE Environment
NODE_ENV=development

# ==========================================
# DATABASE - PostgreSQL (Local Docker)
# ==========================================
DB_USER=kanda_user
DB_PASSWORD=kanda_password
DB_NAME=kanda_dev
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://kanda_user:kanda_password@postgres:5432/kanda_dev

# ==========================================
# REDIS - Cache (Local Docker)
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_EXPIRATION=86400

# ==========================================
# FIREBASE Configuration (Optional)
# ==========================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# ==========================================
# APPYPAY Payment Gateway (Sandbox)
# ==========================================
APPYPAY_API_KEY=sandbox_api_key
APPYPAY_SECRET_KEY=sandbox_secret_key
APPYPAY_WEBHOOK_SECRET=sandbox_webhook_secret

# ==========================================
# n8n Workflow Engine
# ==========================================
N8N_USER=admin
N8N_PASSWORD=password
N8N_INTERNAL_KEY=your-n8n-internal-key-32-characters-minimum1234567890
N8N_WEBHOOK_URL=http://n8n:5678

# ==========================================
# WAHA WhatsApp API
# ==========================================
WAHA_API_URL=http://waha:8000

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug

# ==========================================
# FRONTEND Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==========================================
# CORS Configuration (Local)
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
