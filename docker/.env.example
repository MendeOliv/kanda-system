# ==========================================
# ENVIRONMENT VARIABLES - KANDA SYSTEM
# ==========================================
# Copy this file to .env and fill in the values

# ==========================================
# DEVELOPMENT / PRODUCTION SWITCH
# ==========================================
NODE_ENV=development
# Use "development" for local Docker Compose
# Use "production" for Render/Vercel deployment

# ==========================================
# DATABASE - PostgreSQL
# ==========================================
# LOCAL (Docker Compose):
# DATABASE_URL=postgresql://kanda_user:kanda_password@postgres:5432/kanda_dev
#
# PRODUCTION (Supabase):
# Get from Supabase dashboard > Project Settings > Database
DATABASE_URL=postgresql://[user]:[password]@db.[project].supabase.co:5432/postgres

DB_USER=kanda_user
DB_PASSWORD=kanda_password
DB_NAME=kanda_dev
DB_HOST=postgres
DB_PORT=5432

# ==========================================
# REDIS CACHE
# ==========================================
# LOCAL (Docker Compose):
# REDIS_URL=redis://redis:6379
#
# PRODUCTION (Upstash):
# Get from Upstash dashboard > Database
REDIS_URL=redis://default:[password]@[host]:[port]

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400

# ==========================================
# FIREBASE Configuration
# ==========================================
# Get from Firebase Console > Project Settings > Service Account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ==========================================
# APPYPAY Payment Integration
# ==========================================
# SANDBOX: Use these for development
# PRODUCTION: Get from AppyPay dashboard
APPYPAY_API_KEY=sandbox_api_key_xxxxx
APPYPAY_SECRET_KEY=sandbox_secret_key_xxxxx
APPYPAY_WEBHOOK_SECRET=sandbox_webhook_secret_xxxxx

# ==========================================
# N8N Workflow Engine
# ==========================================
N8N_USER=admin
N8N_PASSWORD=password
N8N_INTERNAL_KEY=your-n8n-internal-key-32-characters-minimum
N8N_WEBHOOK_URL=http://n8n:5678
# PRODUCTION: Use your Render n8n URL
# N8N_WEBHOOK_URL=https://n8n-xxxxx.onrender.com

# ==========================================
# WAHA WhatsApp API
# ==========================================
WAHA_API_URL=http://waha:8000
# PRODUCTION: Use your Render WAHA URL
# WAHA_API_URL=https://waha-xxxxx.onrender.com

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug
# Use: debug, info, warn, error

# ==========================================
# FRONTEND (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
# PRODUCTION: Use your Render backend URL
# NEXT_PUBLIC_API_URL=https://backend-xxxxx.onrender.com

# ==========================================
# CORS & Security
# ==========================================
# LOCAL:
# CORS_ORIGIN=http://localhost:3000
#
# PRODUCTION: Vercel frontend URL
# CORS_ORIGIN=https://your-vercel-domain.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==========================================
# Optional: Service URLs (for local testing)
# ==========================================
# These can be used to test the services locally
# if you're running them outside of Docker Compose
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
